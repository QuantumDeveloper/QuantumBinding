<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latestmajor</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>QuantumBinding.Clang</PackageId>
    <Version>3.0.0</Version>
    <IsPackable>true</IsPackable>
    <Description>C# bindings to the libclang C API that QuantumBinding.Generator parses headers with, generated by QuantumBinding itself.</Description>
    <PackageTags>interop;bindings;clang;libclang</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="QuantumBinding.Clang.Functions.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuantumBinding.Utils\QuantumBinding.Utils.csproj" />
  </ItemGroup>

</Project>
