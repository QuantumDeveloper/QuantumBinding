<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latestmajor</LangVersion>
    <Platforms>x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CodeGeneration\__CSharpCodeGenerator.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="ClangSharp.dll" />
    <None Remove="libclang.dll" />
    <None Remove="_ClangSharp.dll" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="libclang.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Remove="libclang.dylib" />
    <Content Include="libclang.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- clang's builtin resource headers (stddef.h/stdint.h/stdbool.h + shards), so libclang can resolve <stdint.h>
         when driven programmatically. Copied next to libclang.dll in the output; see ClangParser -resource-dir. -->
    <Content Include="clang-resource\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>clang-resource\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuantumBinding.Clang\QuantumBinding.Clang.csproj" />
<!--    <ProjectReference Include="..\QuantumBinding.ClangSandbox\QuantumBinding.ClangSandbox.csproj" />-->
  </ItemGroup>

</Project>
