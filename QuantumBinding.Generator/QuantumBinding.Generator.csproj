<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latestmajor</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>QuantumBinding.Generator</PackageId>
    <Version>3.0.0</Version>
    <IsPackable>true</IsPackable>
    <Description>Generates C# bindings from C headers through libclang. The native libclang comes from the libclang runtime packages: a project that runs the generator sets its RuntimeIdentifier and restores only its own platform's library.</Description>
    <PackageTags>interop;bindings;generator;clang;libclang;pinvoke</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CodeGeneration\__CSharpCodeGenerator.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="ClangSharp.dll" />
    <None Remove="_ClangSharp.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- clang's builtin resource headers (stddef.h/stdint.h/stdbool.h + shards), so libclang can resolve <stdint.h>
         when driven programmatically. Copied to the output; see ClangParser -resource-dir. A package consumer gets
         them from build\QuantumBinding.Generator.targets. -->
    <Content Include="clang-resource\**\*" Pack="true" PackagePath="clang-resource\">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>clang-resource\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <None Update="build\QuantumBinding.Generator.targets" Pack="true"
          PackagePath="build\QuantumBinding.Generator.targets;buildTransitive\QuantumBinding.Generator.targets" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="libclang" Version="22.1.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuantumBinding.Clang\QuantumBinding.Clang.csproj" />
<!--    <ProjectReference Include="..\QuantumBinding.ClangSandbox\QuantumBinding.ClangSandbox.csproj" />-->
  </ItemGroup>

</Project>
