<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- QuantumBinding packages come only from ../../artifacts, packed from this repository by `dotnet pack -o artifacts`,
       so the sample tests this commit and never a published version of the same number. Everything else comes from
       nuget.org. -->
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="QuantumBinding.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
