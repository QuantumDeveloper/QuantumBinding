<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <Platforms>x64</Platforms>
        <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>QuantumBinding.Utils</PackageId>
        <!-- 2.0.1: the published 2.0.0 was behind this source (no SizeOfCache<T>, which the current generated bindings
             call), so anything rebuilt from here failed to LOAD against it. Republished under a new number rather than
             overwriting 2.0.0, which every cache would have gone on serving from its old copy. -->
        <Version>2.0.1</Version>
        <IsPackable>true</IsPackable>
        <Description>Marshalling helpers shared by the C# bindings QuantumBinding generates: pointer and array conversion, native string handling, and caches of the sizes and layouts the generated interop asks for on every call.</Description>
        <PackageTags>interop;marshalling;native;bindings;pinvoke</PackageTags>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <DefineConstants>TRACE</DefineConstants>
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="System.Memory" Version="4.6.3" />
    </ItemGroup>

</Project>
